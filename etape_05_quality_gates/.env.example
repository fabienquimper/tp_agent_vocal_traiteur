# ─────────────────────────────────────────────────────────────────────────────
# Variables d'environnement – copier vers .env et adapter
# ─────────────────────────────────────────────────────────────────────────────

# Modèle LLM (doit être disponible dans Ollama)
LLM_MODEL=mistral

# Seuil de complexité des commandes (>N unités = commande complexe)
ORDER_COMPLEXITY_THRESHOLD=6

# ─── Blue/Green STT (étape 03) ────────────────────────────────────────────────
# Deux modèles Whisper tournent en parallèle pour le benchmark et le switch B/G.
#
# WHISPER_MODEL_BLUE  → service stt-blue  (la "production actuelle")
# WHISPER_MODEL_GREEN → service stt-green (le "candidat au déploiement")
#
# Modèles disponibles (du plus rapide au plus précis sur CPU) :
#   tiny   : ~15x temps réel, WER ~25% français  (trop imprécis)
#   base   : ~7x  temps réel, WER ~12% français  (bon compromis)
#   small  : ~4x  temps réel, WER ~6%  français  (recommandé)
#   medium : ~2x  temps réel, WER ~4%  français  (lent sur CPU)
#   large-v3 : ~1x temps réel, WER ~2% français  (très lent sur CPU)
#
# Note : "temps réel" = un audio de 10s prend X secondes à transcrire.
# "base" à 7x temps réel : 10s d'audio → transcrit en ~1.4s.

WHISPER_MODEL_BLUE=base
WHISPER_MODEL_GREEN=small

# Périphérique de calcul Whisper (s'applique aux deux services)
WHISPER_DEVICE=cpu
#WHISPER_DEVICE=cuda

# ─── Observabilité (étape 02+) ────────────────────────────────────────────────
GRAFANA_PASSWORD=admin
