# ─────────────────────────────────────────────────────────────────────────────
# Étape 02 – Variables d'environnement
# Copier ce fichier en .env et adapter les valeurs.
# ─────────────────────────────────────────────────────────────────────────────

# ── STT (Speech-to-Text) ──────────────────────────────────────────────────────
# Providers : groq | local_ollama | local_lms
STT_PROVIDER=groq
STT_MODEL=whisper-large-v3-turbo

# ── TTS ───────────────────────────────────────────────────────────────────────
#TTS_PROVIDER=groq
TTS_PROVIDER=embedded
GROQ_TTS_VOICE=Celeste-PlayAI   # optionnel

# ── LLM ───────────────────────────────────────────────────────────────────────
# Providers : groq | mistral | local_ollama | local_lms
LLM_PROVIDER=groq
LLM_MODEL=llama-3.1-8b-instant
LLM_TEMPERATURE=0.1

# ── Provider Groq (STT + LLM via API Groq — gratuit) ─────────────────────────
# Token sur https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx

# ── Provider Mistral (LLM via API La Plateforme) ─────────────────────────────
# Token sur https://console.mistral.ai/api-keys
#MISTRAL_API_KEY=...
#LLM_PROVIDER=mistral
#LLM_MODEL=mistral-small-latest

# ── Provider local Ollama (LLM + STT 100 % hors-ligne) ───────────────────────
# Ollama doit tourner sur l'hôte : ./scripts/setup_ollama_local.sh
#LLM_PROVIDER=local_ollama
#LLM_MODEL=qwen2.5:7b
#OLLAMA_BASE_URL=http://host.docker.internal:11434
# Pour le STT local (faster-whisper dans le conteneur) :
#STT_PROVIDER=local_ollama
#WHISPER_MODEL=base          # tiny | base | small | medium | large-v2 | large-v3
#WHISPER_DEVICE=cpu          # cpu | cuda (RTX recommandé pour large-v3)

# ── Provider LM Studio ───────────────────────────────────────────────────────
#LLM_PROVIDER=local_lms
#STT_PROVIDER=local_lms
#LMS_BASE_URL=http://host.docker.internal:1234

# ── Logique métier ────────────────────────────────────────────────────────────
# Seuil : commande avec > N unités = "complexe" (traitement manuel)
ORDER_COMPLEXITY_THRESHOLD=6

# ── RGPD / Debug ─────────────────────────────────────────────────────────────
# NE PAS activer en production (loggue les transcriptions STT)
DEBUG_LOCAL=false