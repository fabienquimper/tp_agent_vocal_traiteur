# ─────────────────────────────────────────────────────────────────────────────
# Variables d'environnement – copier vers .env et adapter
# ─────────────────────────────────────────────────────────────────────────────

# ── Mode local (défaut) ───────────────────────────────────────────────────────

# Modèle LLM (doit être disponible dans Ollama)
LLM_MODEL=mistral

# Seuil de complexité des commandes (>N unités = commande complexe)
ORDER_COMPLEXITY_THRESHOLD=6

# Modèle Whisper pour la transcription vocale
# Choix possibles (du plus rapide au plus précis) : tiny, base, small, medium, large-v2, large-v3
# Attention : les grands modèles sont très lents sur CPU
WHISPER_MODEL=medium

# Périphérique de calcul pour Whisper : cpu ou cuda (GPU NVIDIA requis)
WHISPER_DEVICE=cpu
#WHISPER_DEVICE=cuda

# ── Mode Mistral (LLM via API Mistral AI) ────────────────────────────────────
# Utiliser avec : make up-mistral MISTRAL_API_KEY=...
#
# Token Mistral (sur https://console.mistral.ai/api-keys)
#MISTRAL_API_KEY=...
#
# Modèles disponibles : mistral-small-latest (défaut), mistral-large-latest
#MISTRAL_LLM_MODEL=mistral-small-latest

# ── Mode HuggingFace (APIs distantes) ────────────────────────────────────────
# Utiliser avec : docker compose -f docker-compose.yml -f docker-compose.hf.yml up
# ou            : make up-hf HF_API_TOKEN=hf_xxxxxxxxxxxx
#
# Token HuggingFace (gratuit sur https://huggingface.co/settings/tokens)
#HF_API_TOKEN=hf_xxxxxxxxxxxx
#
# Modèles utilisés (modifiables)
#HF_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
#HF_STT_MODEL=openai/whisper-large-v3
#HF_TTS_MODEL=hexgrad/Kokoro-82M